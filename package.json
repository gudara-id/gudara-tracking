{
  "name": "gudara-production-sewing-tracker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https -H 0.0.0.0",
    "prisma:generate": "prisma generate",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy",
    "d1:migrate:local": "wrangler d1 execute gudara-db --local --file=./prisma/migration.sql",
    "d1:migrate:remote": "wrangler d1 execute gudara-db --remote --file=./prisma/migration.sql",
    "d1:seed:local": "wrangler d1 execute gudara-db --local --file=./prisma/seed.sql",
    "d1:seed:remote": "wrangler d1 execute gudara-db --remote --file=./prisma/seed.sql"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^5.22.0",
    "@prisma/client": "^5.18.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^2.4.3",
    "cloudflare": "^4.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jose": "^5.6.3",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.417.0",
    "next": "15.5.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^2.4.0",
    "unenv": "1.10.0",
    "workerd": "^1.20260804.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@opennextjs/cloudflare": "^1.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "wrangler": "^4.86.0"
  }
}

{
  "name": "gudara-tracker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gudara-db",
      "database_id": "REPLACE-WITH-YOUR-D1-DATABASE-ID"
    }
  ]
}
